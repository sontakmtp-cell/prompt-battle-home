{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@promptchien/contracts": [
        "../packages/contracts/dist/src/index.d.ts"
      ],
      "@promptchien/core": [
        "../packages/core/dist/src/index.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
